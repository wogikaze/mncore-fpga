//   MN_M_<FIELD>_<ENUM>.
//   macros (global, defined once): `MN_M_<FIELD>(w) is the field of a [81:0] word w;
//   error kinds `MN_DEC_OK / `MN_DEC_E_DECODE / `MN_DEC_E_UNSUPPORTED.
// Bit numbering (contract 06 section 2): pos 0 is the leftmost character of the word = mw[81];
// a field's MSB is at its smallest pos, so field = mw[81-pos -: width].
// _IDX is the field's index in the YAML (= CSV column), used by err_field / unsup_vec.
//
// GENERATED by mncore/tools/gen_dec.py from mncore/spec/isa/m.yaml. Do not edit; rerun the generator.

`ifndef MN_MFIELDS_MACROS
`define MN_MFIELDS_MACROS
`define MN_M_VALID(w) w[81]
`define MN_M_MMODE(w) w[80:78]
`define MN_M_TMODE(w) w[77:75]
`define MN_M_DESTID(w) w[74:72]
`define MN_M_SRCID(w) w[71:69]
`define MN_M_DMODE(w) w[68:67]
`define MN_M_MVID(w) w[66:59]
`define MN_M_INDIRECT(w) w[58]
