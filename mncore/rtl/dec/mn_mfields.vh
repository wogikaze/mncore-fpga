`define MN_M_ADRB(w) w[27:13]
`define MN_M_NW(w) w[12:2]
`define MN_M_PRIORITY(w) w[1:0]
`endif

`ifndef MN_DEC_CODES
`define MN_DEC_CODES
`define MN_DEC_OK 2'd0  // no error
`define MN_DEC_E_DECODE 2'd1  // ll = 10 (the emulator stops)
`define MN_DEC_E_UNSUPPORTED 2'd2  // a field value the decoder does not know (err_field names it)
`endif

