# FizzBuzz PE (problems/challenge/23.fizzbuzz-pe) with the integer ALU only (mncore/demo, WP41).
# Each PE: n = the 8 numbers of LM0 ($lm0v: one long word = 2 numbers per cycle, 4 cycles), 1 <= n <= 2^15.
# LM1 gets n, or 0xFFFFBBBB / 0x0000FFFF / 0x0000BBBB for the multiples of 15 / 3 / 5.
# 16 = 1 (mod 15): the sum of the hexadecimal digits keeps n mod 15. Three folds bring n to s in 1..17,
# s = n (mod 15). A table with a 0 bit at each s that is a multiple of 3 (5, 15) is shifted right by s;
# its lowest bit is 0 exactly for the multiples, and iand writes 1 to the mask register when its output
# is all 0 (SDM 3.6.12.1). The masks then select the masked imm writes.
imm ui"0x000000FF" $lr32/1000               # constants in GRF0 (cycle 0 only, read as scalars)
imm ui"0x00000008" $lr34/1000
imm ui"0x0000000F" $lr36/1000
imm ui"0x00000004" $lr38/1000
imm ui"0x00036DB7" $lr40/1000               # bits 0..17 except 3, 6, 9, 12, 15
imm ui"0x00037BDF" $lr42/1000               # bits 0..17 except 5, 10, 15
imm ui"0x00037FFF" $lr44/1000               # bits 0..17 except 15
imm ui"0x00000001" $lr46/1000
iand $lm0v $lr32 $ls0v                      # n & 0xFF
ilsr $lm0v $lr34 $nowrite                   # n >> 8
iadd $aluf $ls0v $ls0v                      # s1 = (n >> 8) + (n & 0xFF) <= 383
iand $aluf $lr36 $ls8v
ilsr $ls0v $lr38 $nowrite
iadd $aluf $ls8v $ls0v                      # s2 = (s1 >> 4) + (s1 & 15) <= 38
iand $aluf $lr36 $ls8v
ilsr $ls0v $lr38 $nowrite
iadd $aluf $ls8v $ls0v                      # s3 = (s2 >> 4) + (s2 & 15) <= 17
ilsr $lr40 $aluf $nowrite
iand $aluf $lr46 $omr1                      # omr1: multiple of 3
ilsr $lr42 $ls0v $nowrite
iand $aluf $lr46 $omr2                      # omr2: multiple of 5
ilsr $lr44 $ls0v $nowrite
iand $aluf $lr46 $omr3                      # omr3: multiple of 15
ipassa $lm0v $ln0v                          # LM1 = n
imm ui"0x0000BBBB" $ln0v/$imr2              # Buzz
imm ui"0x0000FFFF" $ln0v/$imr1              # Fizz
imm ui"0xFFFFBBBB" $ln0v/$imr3              # FizzBuzz
